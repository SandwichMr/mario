<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/teto_blush"
    tools:context=".SecondActivity">

    <ImageView
        android:id="@+id/imgTetoLogoSecond"
        android:layout_width="148dp"
        android:layout_height="148dp"
        android:layout_marginTop="72dp"
        android:contentDescription="Logo Kasane Teto"
        android:scaleType="centerCrop"
        android:src="@drawable/kasane_teto_logo"
        app:layout_constraintBottom_toTopOf="@+id/textViewIntent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textViewIntent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mario was here"
        android:textAlignment="center"
        android:textColor="@color/teto_deep_red"
        android:textSize="12pt"
        android:textStyle="bold|italic"
        app:layout_constraintBottom_toTopOf="@+id/btnsiguiente2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgTetoLogoSecond" />
    <Button
        android:id="@+id/btnsiguiente2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="208dp"
        android:backgroundTint="@color/teto_deep_red"
        android:text="Siguiente Pantalla"
        android:textAlignment="center"
        android:textColor="@color/teto_cream"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
